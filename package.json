{
  "name": "crm-clinicas",
  "version": "0.0.0",
  "private": true,
  "description": "CRM SaaS multi-tenant para clínicas de estética",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "db:types": "supabase gen types typescript --local",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "harness:shoot": "node scripts/visual-harness/shoot.mjs",
    "harness:measure": "node scripts/visual-harness/measure-blocks.mjs",
    "seed:dev": "node scripts/seed-dev/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "pg": "8.23.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "supabase": "2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.9": "5.0.9",
      "minimatch@3.1.5": "10.2.5",
      "postcss@<8.5.23": ">=8.5.23"
    },
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}
