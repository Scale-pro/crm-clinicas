# Exemplo de configuração de ambiente — NUNCA coloque valores reais/segredos
# neste arquivo (ele é versionado). Copie para .env.local e ajuste.
# Convenções e regras: docs/ops/environments.md

# Ambiente lógico da aplicação: development | staging | production
APP_ENV=development

# Valores emitidos por `pnpm supabase start`; use exclusivamente a stack local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-stack-output

# Segredo server-only com no mínimo 32 caracteres. Gere um valor local aleatório.
ACTIVE_CLINIC_COOKIE_SECRET=replace-with-a-local-random-secret
